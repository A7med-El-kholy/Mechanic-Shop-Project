<Project>
  <!-- Enable Central Package Management for the entire repository. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Test SDK used by all three test projects. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.2" />
    <!-- Fluent, readable assertions (community fork of FluentAssertions, Apache 2.0). -->
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>

  <!-- ASP.NET Core Identity + EF Core SQL Server provider: first real use is F2 (auth + database). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Design-time only (migrations tooling); never flows to consumers. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- JWT bearer authentication middleware (Api layer). -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <!-- JWT token generation (Infrastructure TokenProvider). -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- Transitive System.Security.Cryptography.Pkcs 9.0.x carries known advisories
         (NU1902/NU1903, escalated to errors by TreatWarningsAsErrors). Pin the patched
         10.0.13 so the whole graph resolves a safe version. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- OpenAPI UI for the API (first real use: F16 portal demo story). Version 8.x
       targets net8.0 and forward-rolls on net10.0 at runtime. -->
  <ItemGroup>
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="8.0.0" />
  </ItemGroup>

  <!-- Real SQL Server in a container for database-backed integration tests.
       First real use: F2 auth tests (the ApiFactory comment anticipated this). -->
  <ItemGroup>
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>

  <!-- CQRS mediation: commands/queries as first-class messages (Features/*). First real use: F3 customers CRUD.
       12.5.0 is the final Apache-2.0 line; 13.x moved to a commercial license. -->
  <ItemGroup>
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <!-- FluentValidation validators wired into a MediatR pipeline behavior. Apache 2.0. -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <!-- EF Core abstractions only (IAppDbContext, LINQ operators, DbUpdateException).
         The SQL Server provider stays in Infrastructure — handlers never see the provider. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>

  <!-- Add packages only when they have their first real use; do not add packages just in case. -->
</Project>
