# Copy to .env and fill in. .env is gitignored.
SQL_PASSWORD=ChangeMe_Str0ng!Passw0rd
MANAGER_PASSWORD=ChangeMe_Manager#2026
# Set true for a local demo database. Keep false for a real production database.
DEMO_SEED_DATA=false
# Generate with:  openssl rand -base64 48
JWT_SECRET=

# Google OAuth (Sign in with Google). See GoogleOAuth.md for the Google Cloud Console setup.
# These are consumed via docker-compose as GoogleAuth__ClientId / GoogleAuth__ClientSecret.
# Alternatively set them with:  dotnet user-secrets set GoogleAuth:ClientId "<id>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the Angular frontend (backend redirects to <BaseUrl>/auth/callback#access_token=...).
FRONTEND_BASE_URL=http://localhost:4200

# AI diagnostics: Mock works without a key. Set AI_PROVIDER=OpenAI and add a
# valid OpenAI API key to enable model-generated text and image diagnoses.
AI_PROVIDER=Mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
