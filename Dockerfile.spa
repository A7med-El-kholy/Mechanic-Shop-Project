# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /web
COPY src/MechanicShop.Web/package.json src/MechanicShop.Web/package-lock.json ./
RUN npm ci
COPY src/MechanicShop.Web/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /web/dist/mechanic-shop-web/browser /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
ENTRYPOINT ["nginx", "-g", "daemon off;"]
