<!-- Composition root: configures the application and connects Application with Infrastructure. -->

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Enables "dotnet user-secrets" so the connection string and JWT key stay out of source control. -->
    <UserSecretsId>MechanicShopWorkshopSystem-Api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MechanicShop.Application\MechanicShop.Application.csproj" />
    <ProjectReference Include="..\MechanicShop.Infrastructure\MechanicShop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bearer-token authentication middleware; validates the JWTs issued by Infrastructure's TokenProvider. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Design-time only: EF tools require this on the startup project to run migrations.
         PrivateAssets=all keeps it out of any project that references the Api. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- OpenAPI: /swagger UI for exploring and testing the API from the browser. -->
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

</Project>
