{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "MechanicShop",
    "Audience": "MechanicShopPortal",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost",
      "http://localhost:4200",
      "http://localhost:5255",
      "http://127.0.0.1",
      "http://127.0.0.1:4200",
      "http://127.0.0.1:5255"
    ]
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "GoogleAuth": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "AISettings": {
    "Provider": "Mock",
    "OpenAI": {
      "ApiKey": "",
      "BaseUrl": "https://api.openai.com/v1",
      "Model": "gpt-4o-mini",
      "TranscriptionModel": "whisper-1",
      "SpeechModel": "tts-1",
      "TimeoutSeconds": 30
    }
  },
  "Swagger": {
    "Enabled": false
  }
}
